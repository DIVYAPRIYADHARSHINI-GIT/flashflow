{
	"name": "flashflow",
	"version": "1.0.0",
	"private": true,
	"description": "FlashFlow - free spaced repetition flashcard study app. Study less. Remember more.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"probe": "vitest run --config probes/vitest.probe.config.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "7.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"pdfjs-dist": "6.4.299",
		"playwright": "1.64.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "1.1.1",
		"pdf-lib": "1.17.1"
	}
}
