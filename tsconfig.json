{
	"extends": "$app/tsconfig",
	"include": ["src", "*"],
	"exclude": ["src/service-worker", "probes"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	}
}
